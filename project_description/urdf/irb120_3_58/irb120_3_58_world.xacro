<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="irb120_assembly">

  <!-- 1. Pure Robot + Gripper -->
  <xacro:include filename="$(find project_description)/urdf/irb120_3_58/irb120_3_58_robot.urdf" />

  <!-- 2. Root Frame -->
  <joint name="world_to_robot" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0.32 0" rpy="0 0 0" />
  </joint>

</robot>