<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="irb120_assembly">

  <!-- 1. Include Robot Arm Macro -->
  <xacro:include filename="$(find project_description)/urdf/irb120_3_58/irb120_3_58_macro.xacro"/>
  
  <!-- 2. Include Gripper Macro -->
  <xacro:include filename="$(find project_description)/urdf/2fg7/onrobot_2fg7.xacro"/>

  <!-- 3. Include Taskboard Environment URDF -->
  <xacro:include filename="$(find project_description)/urdf/taskboard/taskboard_environment.urdf"/>

  <!-- 4. Base World Link & Fixed Joint to Robot Base -->
  <link name="world" />
  
  <joint name="world_to_robot" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0.32 0" rpy="0 0 0" />
  </joint>

  <!-- 5. Instantiate ABB IRB 120 -->
  <xacro:abb_irb120_3_58 prefix=""/>

  <!-- 6. Instantiate OnRobot 2FG7 attached to tool0 -->
  <xacro:onrobot_2fg7 prefix="" parent="tool0">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:onrobot_2fg7>

</robot>